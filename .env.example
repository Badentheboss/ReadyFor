# Copy to .env and fill in. Never commit .env.

# --- iMessage adapter (Photon Spectrum) ---
PROJECT_ID=
PROJECT_SECRET=
CORE_URL=http://localhost:8787

# --- Core service ---
CORE_PORT=8787
# Leave empty to run on the keyword-based fake model (no AI). Set for real classification and lab photo reading.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or retired.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview
# Leave empty to run on an in-memory database (resets on restart). Set to your Neon connection string for the real demo.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Phone number (E.164, e.g. +17345550100) that plays the demo patient Harriet in iMessage.
DEMO_PATIENT_PHONE=
CLINIC_NAME=Northstar Surgical Center
CLINIC_PHONE=(734) 555-0100
# Set to 1 to read health records and drug classes from local fixtures instead of the live APIs.
RECORD_FIXTURES=

# --- Staff login (Neon Auth) ---
# Leave NEON_AUTH_BASE_URL empty to run with auth off (local only). `neon env pull` fills the two Neon values.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Who may sign in, separated by ";": "email,role,Name[,asiSender]" or "id:<neon user id>,role,Name[,asiSender]".
# Roles: coordinator, nurse, surgeon, admin. Email entries match only after the email is verified.
STAFF_ALLOWLIST=
# Service tokens (32+ characters, e.g. `openssl rand -hex 32`). Give the same values to the adapter and the agent.
IMESSAGE_SERVICE_TOKEN=
AGENT_SERVICE_TOKEN=
# Browser origins allowed to call the core, comma-separated. Default with auth on: http://localhost:4173
CORS_ORIGINS=
# Set to 1 in any deployed environment so the core refuses to start with auth off.
AUTH_REQUIRED=

# --- Urgent escalation ---
# On-call ladder phones (E.164). Each must also be a user on the Photon project to receive texts.
ONCALL_PRIMARY_PHONE=
ONCALL_BACKUP_PHONE=
ONCALL_LAST_PHONE=
# Minutes before an unacknowledged alert moves to the next person (use 1 for a live demo).
ESCALATION_MINUTES=5
ESCALATION_CHECK_SECONDS=20

# --- Scheduled recheck ---
RECHECK_INTERVAL_MINUTES=60
RECHECK_AFTER_HOURS=24
# How far ahead the scheduled recheck looks, in days (the dashboard can show up to 8 weeks).
RECHECK_HORIZON_DAYS=56
