# Required: generate a unique private seed phrase for this agent and keep it local.
UAGENT_SEED=replace-with-a-long-random-private-seed

# Optional runtime settings.
UAGENT_NAME=readyfor-coordinator
UAGENT_HOST=127.0.0.1
UAGENT_PORT=8000

# Set only after the API routes and payloads are documented in docs/contract.md.
READYFOR_CORE_URL=
READYFOR_CORE_TIMEOUT_SECONDS=5

# Agentverse mailbox setup is done in Agentverse using its generated connection flow.
# Do not put API/account credentials in source control.
