# Required: generate a unique private seed phrase for this agent and keep it local.
UAGENT_SEED=replace-with-a-long-random-private-seed

# Optional runtime settings.
UAGENT_NAME=readyfor-coordinator
UAGENT_PORT=8000

# Point this at the core. Remote Agentverse runs need a publicly reachable URL.
READYFOR_CORE_URL=http://localhost:8787
READYFOR_CORE_TIMEOUT_SECONDS=5

# Required: the same AGENT_SERVICE_TOKEN configured on the core, at least 32 characters.
# Generate it locally with openssl rand -hex 32; never paste it into chat or commit it.
AGENT_SERVICE_TOKEN=

# Agentverse mailbox setup is done in Agentverse using its generated connection flow.
# Do not put API/account credentials in source control.
